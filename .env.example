# "mock" = deterministic offline classifier (development/tests ONLY); "gemini" = real API.
# Default when unset is now "gemini" (the app refuses to start without GEMINI_API_KEY) - mock must be explicit.
KAVACH_LLM_MODE=mock
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_TIMEOUT_SECONDS=30
# "memory" or "postgres"
KAVACH_REPOSITORY=memory
DATABASE_URL=postgresql://user:pass@localhost:5432/kavach
KAVACH_MAX_IMAGE_BYTES=8388608
KAVACH_MAX_IMAGES=4

# ---- added in 1.1.0 (all optional) ----
# Folder where accepted original images are stored (unset = in-memory, lost on restart)
KAVACH_MEDIA_DIR=
# Shared key required in the X-API-Key header for GET /api/v1/incidents/{id} (unset = reads disabled, 403)
KAVACH_READ_API_KEY=
# Max complaints per minute per client IP on POST (0 = off)
KAVACH_RATE_LIMIT_PER_MINUTE=30
# Duplicate Detection Agent endpoint; if set, each new record is POSTed there after it is saved
KAVACH_DUPLICATE_DETECTION_URL=
KAVACH_HANDOFF_TIMEOUT_SECONDS=10
