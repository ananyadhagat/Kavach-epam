
KAVACH_RULE_VERSION=demo-0.1
KAVACH_PASS_THRESHOLD=75
KAVACH_REQUIRE_GPS=true

# Vision provider: mock (default) or gemini.
VISION_PROVIDER=mock
GEMINI_API_KEY=
# GEMINI_MODEL must be set when VISION_PROVIDER=gemini; choose a model in your Google AI Studio account.
# GEMINI_MODEL=
VISION_MAX_RETRIES=2
VISION_TIMEOUT_SECONDS=30
VISION_MAX_IMAGE_MB=5
VISION_PROMPT_VERSION=vision-prompt-v1

KAVACH_GPS_MAX_ACCURACY_M=100
# Root directory for trusted image storage references recorded by the server.
KAVACH_EVIDENCE_ROOT=stored_evidence
# Optional global override; otherwise each task's site tolerance_m is used.
# KAVACH_GPS_TOLERANCE_M=150
KAVACH_VISION_MODEL_VERSION=mock-vision-1
KAVACH_DB_PATH=verification_audit.db
KAVACH_API_KEY=
KAVACH_REPOSITORY_PROVIDER=memory

# Deterministic OpenCV quality checks (illustrative defaults; tune on real field photos).
QUALITY_BLUR_THRESHOLD=100
QUALITY_MIN_BRIGHTNESS=35
QUALITY_MAX_BRIGHTNESS=225
QUALITY_MIN_WIDTH=640
QUALITY_MIN_HEIGHT=480
QUALITY_DUPLICATE_HASH_DISTANCE=5
