# Copy to .env for local development. Never commit .env.
# Replace every <placeholder>. Do not reuse these passwords elsewhere.

# development | test | production
# Demo bearer-token authentication is refused when APP_ENV=production.
APP_ENV=development

# --- PostgreSQL (required; there is no other storage backend) ---------------
# Percent-encode special characters in passwords (e.g. @ -> %40, : -> %3A).
DATABASE_URL=postgresql+asyncpg://kavach_app:<app-password>@localhost:5432/kavach
# Used only by pytest. The database name MUST end in _test; the test suite
# empties its tables before every test.
TEST_DATABASE_URL=postgresql+asyncpg://kavach_app:<app-password>@localhost:5432/kavach_test
DATABASE_CONNECT_TIMEOUT_SECONDS=5
# Insert the demo worker and TASK-001 at startup if missing (never overwrites).
SEED_DEMO_DATA=true

# --- Demo authentication (local development only) ---------------------------
# Minimum 8 characters.
DEMO_WORKER_TOKEN=<choose-a-local-token>
DEMO_WORKER_ID=worker-001

# --- Evidence uploads ---------------------------------------------------------
# Bytes. Default is 5 MB.
MAX_IMAGE_SIZE_BYTES=5242880
# IMAGE_STORAGE_DIR=./private_uploads

# --- Location -----------------------------------------------------------------
# GPS fixes less accurate than this are stored as INACCURATE.
MAX_GPS_ACCURACY_METERS=100
# When true, completion requires a recorded arrival location event.
REQUIRE_ARRIVAL_LOCATION=false
