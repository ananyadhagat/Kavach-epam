# Copy to .env and fill in. NEVER commit or share .env.
KAVACH_LLM_MODE=mock          # mock = no API call, gemini = real Gemini call
GEMINI_API_KEY=               # your Google AI Studio key (GOOGLE_API_KEY also works)
GEMINI_MODEL=gemini-2.5-flash # use a model name available to your account
KAVACH_REQUIRE_DUPLICATE_CHECK=false   # set true once process 2.0 supplies duplicate_check
