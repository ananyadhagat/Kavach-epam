# GeoSatya configuration. Copy to .env for local use. Never commit .env.
# Every value here is a placeholder or a safe local default.

# development | test | production
APP_ENV=development

# demo:  no sign-in; pick a demo role in the top bar (refused in production)
# token: bearer tokens mapped to user IDs, until a real identity provider is wired in
AUTH_MODE=demo
# AUTH_TOKENS=<random-token-16+-chars>:SUP-DEMO-03

# Storage (SQLite by default, no server needed)
# DATABASE_URL=sqlite:///./data/geosatya_v3.db
# STORAGE_DIR=./private_uploads

# Location rules (starting values; a supervisor can change them in Settings)
GEOFENCE_RADIUS_M=15        # allowed 10-20
MAX_ACCURACY_M=25           # weaker GPS readings never pass; allowed 10-100
EXIF_TOLERANCE_M=50         # photo GPS further than this is a conflict
LOCATION_FRESHNESS_S=30     # a fix older than this at photo time is refreshed

# Simulated GPS (the "Simulate GPS" switch). Always labelled, never real.
# Empty = can pass only in development. Production always refuses simulation.
# SIMULATED_CAN_PASS=false

# Maps: leave empty to use OpenStreetMap (free). A Google browser key is
# visible to visitors by design: restrict it to your site and the Maps
# JavaScript API in Google Cloud. Google needs billing enabled on the project.
GOOGLE_MAPS_BROWSER_KEY=
# GOOGLE_MAPS_MAP_ID=

SEED_DEMO_DATA=true
# Only if the frontend is hosted separately, e.g. https://geosatya.vercel.app
CORS_ORIGINS=

# ---- KAVACH integration (all optional; safe local defaults) ----
# Incident Intelligence agent (branch incident-intelligence-agent), run separately,
# e.g. on port 8001. Empty = reports are still accepted, marked "analysis not configured".
INTELLIGENCE_URL=
# INTELLIGENCE_URL=http://127.0.0.1:8001
INTELLIGENCE_TIMEOUT_S=8

# Dispatch (ranking rules from branch dispatch-work)
DISPATCH_MAX_RADIUS_KM=2
DISPATCH_LOCATION_MAX_AGE_S=900
# workload = if nobody qualified has shared a recent location, assign by workload (labelled)
# escalate = leave the incident unassigned for a supervisor
DISPATCH_FALLBACK=workload
# an assignment not accepted within this many minutes is flagged; a supervisor can re-dispatch it
ACCEPTANCE_TIMEOUT_MIN=15

# Live tracking and ETA (approximate; no routing provider is configured)
TRACKING_MIN_INTERVAL_S=10
TRACKING_STALE_S=120
TRACKING_HISTORY_KEEP=20
ARRIVAL_RADIUS_M=50
# consecutive good readings inside the arrival radius needed to record arrival
ARRIVAL_CONFIRM_READINGS=2
# no progress toward the incident for this long marks the worker as stationary
STATIONARY_AFTER_S=180
ETA_ASSUMED_SPEED_KMH=20
ETA_ROUTE_FACTOR=1.4

# Resolution estimate (ETR) baseline until enough history exists
ETR_DEFAULT_TRAVEL_MIN=30
ETR_REVIEW_BUFFER_MIN=30
ETR_HISTORY_MIN_SAMPLES=3

# ---- Road routing (optional; replaceable provider) ----
# none = straight-line ETA only. osrm = road routes + travel times from an OSRM server.
# https://router.project-osrm.org is a public DEMO server: light testing only, not for production.
ROUTING_PROVIDER=none
# ROUTING_URL=https://router.project-osrm.org
ROUTING_PROFILE=driving
ROUTING_TIMEOUT_S=4
ROUTING_CACHE_S=120
# Dispatch compares road travel time for this many top-ranked eligible workers
DISPATCH_ROUTE_CANDIDATES=3
# Worker locations less accurate than this are not used for dispatch distance
DISPATCH_MAX_LOCATION_ACCURACY_M=200
# Citizen report submissions per user per minute (0 = off; single-process limiter)
REPORT_RATE_LIMIT_PER_MIN=10
