# GeoSatya configuration. Copy to .env for local use. Never commit .env.
# Every value here is a placeholder or a safe local default.

# development | test | production
APP_ENV=development

# demo:  no sign-in; pick a demo role in the top bar (refused in production)
# token: bearer tokens mapped to user IDs, until a real identity provider is wired in
AUTH_MODE=demo
# AUTH_TOKENS=<random-token-16+-chars>:SUP-DEMO-03

# Storage (SQLite by default, no server needed)
# DATABASE_URL=sqlite:///./data/geosatya_v3.db
# STORAGE_DIR=./private_uploads

# Location rules (starting values; a supervisor can change them in Settings)
GEOFENCE_RADIUS_M=15        # allowed 10-20
MAX_ACCURACY_M=25           # weaker GPS readings never pass; allowed 10-100
EXIF_TOLERANCE_M=50         # photo GPS further than this is a conflict
LOCATION_FRESHNESS_S=30     # a fix older than this at photo time is refreshed

# Simulated GPS (the "Simulate GPS" switch). Always labelled, never real.
# Empty = can pass only in development. Production always refuses simulation.
# SIMULATED_CAN_PASS=false

# Maps: leave empty to use OpenStreetMap (free). A Google browser key is
# visible to visitors by design: restrict it to your site and the Maps
# JavaScript API in Google Cloud. Google needs billing enabled on the project.
GOOGLE_MAPS_BROWSER_KEY=
# GOOGLE_MAPS_MAP_ID=

SEED_DEMO_DATA=true
# Only if the frontend is hosted separately, e.g. https://geosatya.vercel.app
CORS_ORIGINS=
